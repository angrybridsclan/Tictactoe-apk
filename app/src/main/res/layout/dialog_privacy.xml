<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_cyber"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="PRIVACY POLICY &amp; INFO"
        android:textColor="@color/neon_pink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@color/neon_pink_glow" />

    <!-- App Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_cyber"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App: Tic Tac Toe (Neon Cyber)"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Package: com.aistudio.tictactoe.neon"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Version: 1.0.0 (Build 1)"
            android:textColor="@color/neon_gold"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Developer: Mahinur Rahman Saif"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Contact: mahinurrahmansaif@gmail.com"
            android:textColor="@color/neon_pink"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Privacy Text Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We respect your privacy. This game uses Google AdMob to display advertisements (Banner, Interstitial, Native, and Rewarded Video Ads). AdMob may collect and use device identifiers and non-personal diagnostic data in accordance with Google's Privacy Policy to serve relevant ads. No personally identifiable information (PII) is sold or shared. For questions or support, please contact the developer."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btn_close_privacy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_neon_pink"
        android:text="@string/btn_close"
        android:textColor="@color/neon_pink"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
