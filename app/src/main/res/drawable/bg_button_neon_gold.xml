<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/neon_gold_glow">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FF26200B"
                android:endColor="#FF382C0E"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/neon_gold" />
        </shape>
    </item>
</ripple>
