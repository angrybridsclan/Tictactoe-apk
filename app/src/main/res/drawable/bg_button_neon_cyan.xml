<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/neon_cyan_glow">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/cyber_surface"
                android:endColor="#FF0E2A47"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/neon_cyan" />
        </shape>
    </item>
</ripple>
